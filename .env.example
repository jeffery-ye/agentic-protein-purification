# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Runtime mode ---

# dev (the default): local development server, frontend on Vite, CORS limited
# to the Vite origins.
# deploy: the container. No CORS, FastAPI serves the built frontend, and
# internal SSGCID data is off. Changes runtime behaviour only.
APP_ENV=dev

# Optional: override whether internal SSGCID data (CTTdb) is used. Defaults to
# on in dev and off in deploy.
# INTERNAL_DATA=true

# Optional in dev: comma-separated origins allowed to call the API. Defaults to
# the Vite dev server, http://localhost:5173 and http://127.0.0.1:5173.
# DEV_CORS_ORIGINS=http://localhost:5173

# Optional: the most queued or running jobs at once. Defaults to 2.
# MAX_ACTIVE_JOBS=2

# Optional in dev: where the job database (jobs.sqlite3) lives. Defaults to the
# gitignored data/ directory at the repository root. Required in deploy.
# DATA_DIR=./data

# Optional: the commit SHA of this build, stored on each job. Set by deploys.
# APP_VERSION=

# Optional: minutes a job may stay queued or running before it is failed and
# frees its MAX_ACTIVE_JOBS slot. Defaults to 60.
# JOB_DEADLINE_MINUTES=60

# --- Sign-in (deploy only) ---
# dev always signs in as dev@local and refuses AUTH_ENABLED=true. In deploy,
# sign-in stays off (one shared placeholder user) until AUTH_ENABLED=true, which
# then requires the settings below. Parameter Store supplies them in deploy.
# AUTH_ENABLED=true
# COGNITO_DOMAIN=<prefix>.auth.us-east-1.amazoncognito.com
# COGNITO_USER_POOL_ID=us-east-1_AbC123
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=           # optional: only for a confidential app client
# SESSION_SECRET_KEY=              # at least 32 random characters
# REVIEWER_USERNAME=               # optional: the shared reviewer account

# --- Required ---

# Path to the pdbaa BLAST database *stem*: the prefix shared by the
# .phr/.pin/.psq files, not a directory and not one of those files.
BLAST_DB_PATH=C:\db\pdbaa\pdbaa

# Contact address sent with every NCBI Entrez request, as NCBI's usage policy
# requires. Must be a real address you monitor.
ENTREZ_EMAIL=you@example.org

# Optional: an NCBI API key, sent with every PMC fetch. Raises NCBI's limit from
# 3 to 10 requests a second.
# NCBI_API_KEY=

# --- LLM provider ---

# Which provider to use: gemini, openai, anthropic or bedrock. Leave unset for
# the default, gemini. bedrock uses your AWS credentials (for example
# AWS_PROFILE and AWS_REGION) instead of API_KEY.
# LLM_PROVIDER=gemini

# Credential for whichever provider LLM_PROVIDER names. Checked on the first
# LLM call, not at startup, so a missing key fails jobs rather than the boot.
API_KEY=YOUR_API_KEY

# Required: the model within that provider, by the name its API uses. There is
# no default. Checked on the first LLM call, like API_KEY.
LLM_MODEL=YOUR_MODEL

# Optional: a self-hosted or proxied OpenAI-compatible endpoint. Applies only
# to openai: models. OPENAI_BASE_URL is honoured too, but LLM_BASE_URL wins.
# LLM_BASE_URL=http://localhost:1234/v1

# Optional: set to off to stop asking the model for reasoning summaries, which
# the report's Trace tab shows (#77), for a model that rejects the setting.
# Only OpenAI (Responses API) and Gemini are asked.
# LLM_REASONING_SUMMARY=off

# --- Frontend ---

# Where the dev frontend finds the API. Production builds leave it unset and
# call the API on their own origin.
VITE_API_URL=http://localhost:8000

# --- Optional: SSGCID / CTTdb (SQL Server) ---
# Only needed to resolve SSGCID IDs. Authenticates with Windows integrated
# auth, so it requires a domain-joined machine with SSGCID network access.

DB_SERVER=db_server
DB_NAME=SSGCID
DB_DRIVER={ODBC Driver 17 for SQL Server}

# --- Optional: Neo4j taxonomy graph ---
# Adds a taxonomic-distance term to similarity scoring. Takes effect only for
# SSGCID inputs, which are the only ones that supply a target taxonomy ID.

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
